{
  "name": "feralis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Feralis — creature collector + base automation, browser game statico",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "tsx scripts/validate-data.ts",
    "assets:gen": "tsx scripts/gen-assets.ts",
    "maps:build": "tsx scripts/author-maps.ts",
    "balance:sim": "tsx scripts/balance-sim.ts",
    "size-check": "tsx scripts/size-check.ts",
    "verify": "npm run lint && npm run validate:data && npm run test && npm run balance:sim && npm run build && npm run size-check"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.0",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
